# =============================================================================
# Unity + Android .gitignore
# Place at the root of the Unity project directory.
# Tailored for Unity 3D Android (IL2CPP / Burst / Gradle) open-world projects.
# =============================================================================

# -----------------------------------------------------------------------------
# Unity Generated & Cache Directories
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ServerData/
/UIElementsSchema/

# Unity 2023+ / Unity 6 incremental IL2CPP, CMake & Android build cache (very large)
/.utmp/
.utmp/

# Auto-generated caches & test scenes inside Assets
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
InitTestScene*.unity*

# Uncomment if you wish to ignore the Asset Store Tools plugin
# /[Aa]ssets/AssetStoreTools*

# -----------------------------------------------------------------------------
# Android Builds, Gradle, NDK/CMake, IL2CPP & Signing Artifacts
# -----------------------------------------------------------------------------
*.apk
*.aab
*.apks
*.idsig
*.symbols.zip

# Unity IL2CPP & Burst debug/backup folders generated alongside builds (very large)
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Gradle & Android NDK/Studio caches (root and exported Android projects)
.gradle/
/**/.gradle/
.cxx/
/**/.cxx/
.externalNativeBuild/
/**/.externalNativeBuild/
local.properties
/**/local.properties
captures/
output-metadata.json

# Android signing credentials (never commit private keys to version control)
*.keystore
*.keystore.meta
*.jks
*.jks.meta

# Crashlytics generated build properties
crashlytics-build.properties

# -----------------------------------------------------------------------------
# Addressables & Visual Scripting Generated Files
# -----------------------------------------------------------------------------
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# -----------------------------------------------------------------------------
# IDE, Rider, Visual Studio & Code Editor Caches
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/

# Autogenerated JetBrains Rider plugin & personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Autogenerated C# project & solution files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# -----------------------------------------------------------------------------
# Asset Backups, Packages, Logs, Crash Dumps & OS Metadata
# -----------------------------------------------------------------------------
*.blend1
*.blend1.meta
*.unitypackage
*.unitypackage.meta
*.app

*.log
sysinfo.txt
mono_crash.*

# macOS / Windows / Linux OS clutter
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
